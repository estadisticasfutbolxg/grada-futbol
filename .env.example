# Runtime de Sites: configurar como secretos, nunca en el cliente ni en Git.
# Correo verificado del propietario: solo vinculación inicial de su ID de Sites.
GRADA_OWNER_EMAIL=
# Valor aleatorio de al menos 32 caracteres para firmar desbloqueos de 30 min.
GRADA_OWNER_SESSION_SECRET=
# La contraseña la define el propietario en la web; no es una variable de entorno.
